APP_NAME=MS NEXUS AI
ENVIRONMENT=development
RUNTIME_MODE=hybrid
DATABASE_URL=sqlite:///./data/ms_nexus.db
MSNEXUS_API_KEYS=change-this-key
ADMIN_API_KEY=change-admin-key

# EDGE: Ollama on a computer/server controlled by the project
LOCAL_TEXT_BASE_URL=http://ollama:11434
LOCAL_TEXT_MODEL=llama3.2:3b
LOCAL_TEXT_API_KEY=

# CLOUD: optional self-hosted vLLM/llama.cpp endpoint, never a commercial AI API
CLOUD_TEXT_BASE_URL=
CLOUD_TEXT_MODEL=Qwen/Qwen2.5-7B-Instruct
CLOUD_TEXT_API_KEY=

# Self-hosted media nodes; leave empty until each worker is deployed
LOCAL_IMAGE_BASE_URL=
LOCAL_IMAGE_API_KEY=
LOCAL_AUDIO_BASE_URL=
LOCAL_AUDIO_API_KEY=
LOCAL_VIDEO_API_URL=
LOCAL_VIDEO_API_KEY=

AI_TIMEOUT_SECONDS=120
VIDEO_API_URL=
VIDEO_API_KEY=
VIDEO_TIMEOUT_SECONDS=300
VIDEO_WORKER_POLL_SECONDS=3

# MS DIGITAL NETWORK connector (server-side secrets only)
MS_DN_BASE_URL=
MS_DN_WEBHOOK_SECRET=

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
